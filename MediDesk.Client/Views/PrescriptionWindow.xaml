<Window x:Class="MediDesk.Client.Views.PrescriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="처방 내역"
        Height="550"
        Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="TxtVisitInfo"
                Grid.Column="0"
                FontSize="22"
                FontWeight="Bold"
                VerticalAlignment="Center"/>

            <Button
                Grid.Column="1"
                Content="처방 등록"
                Width="100"
                Height="35"
                Click="BtnAddPrescription_Click"/>

        </Grid>

        <DataGrid
            x:Name="PrescriptionDataGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectionUnit="FullRow">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="번호"
                    Binding="{Binding PrescriptionId}"
                    Width="70"/>

                <DataGridTextColumn
                    Header="약품명"
                    Binding="{Binding DrugName}"
                    Width="180"/>

                <DataGridTextColumn
                    Header="용량"
                    Binding="{Binding Dosage}"
                    Width="120"/>

                <DataGridTextColumn
                    Header="횟수"
                    Binding="{Binding Frequency}"
                    Width="80"/>

                <DataGridTextColumn
                    Header="기간"
                    Binding="{Binding Days}"
                    Width="80"/>

                <DataGridTextColumn
                    Header="복용 방법"
                    Binding="{Binding Instructions}"
                    Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>