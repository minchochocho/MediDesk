<Window x:Class="MediDesk.Client.Views.PatientVisitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="진료 기록"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel 
            Margin="0,0,0,15"
            LastChildFill="False">

            <TextBlock
                x:Name="TxtPatientName"
                Text="진료 기록 내역"
                FontSize="24"
                FontWeight="Bold"
                VerticalAlignment="Center"/>

            <Button
                Content="진료 등록"
                Width="100"
                Height="35"
                DockPanel.Dock="Right" Click="Button_Click"/>

        </DockPanel>

        <DataGrid
            x:Name="VisitDataGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectionUnit="FullRow">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="진료번호"
                    Binding="{Binding VisitId}"
                    Width="80"/>

                <DataGridTextColumn
                    Header="진료일"
                    Binding="{Binding VisitDate}"
                    Width="150"/>

                <DataGridTextColumn
                    Header="진료과"
                    Binding="{Binding Department}"
                    Width="120"/>

                <DataGridTextColumn
                    Header="담당의"
                    Binding="{Binding DoctorName}"
                    Width="120"/>

                <DataGridTextColumn
                    Header="증상"
                    Binding="{Binding Symptoms}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="진단"
                    Binding="{Binding Diagnosis}"
                    Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>