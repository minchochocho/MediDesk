<Window x:Class="MediDesk.Client.Views.PrescriptionAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="처방 등록"
        Height="500"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="약 이름"/>
            <TextBox x:Name="TxtDrugName"
                     Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="용량"/>
            <TextBox x:Name="TxtDosage"
                     Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="하루 복용 횟수"/>
            <TextBox x:Name="TxtFrequency"
                     Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="복용 일수"/>
            <TextBox x:Name="TxtDays"
                     Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,20">
            <TextBlock Text="복용 안내"/>
            <TextBox x:Name="TxtInstructions"
                     Height="80"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="등록"
                    Width="80"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="BtnSave_Click"/>

            <Button Content="취소"
                    Width="80"
                    Height="35"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>