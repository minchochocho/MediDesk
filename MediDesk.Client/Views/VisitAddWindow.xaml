<Window x:Class="MediDesk.Client.Views.VisitAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="진료 등록"
        Height="580"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="진료일"/>
            <DatePicker x:Name="DpVisitDate"
                        Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="진료과"/>
            <TextBox x:Name="TxtDepartment"
                     Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="담당의"/>
            <TextBox x:Name="TxtDoctorName"
                     Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="증상"/>
            <TextBox x:Name="TxtSymptoms"
                     Height="60"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="진단"/>
            <TextBox x:Name="TxtDiagnosis"
                     Height="60"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,20">
            <TextBlock Text="메모"/>
            <TextBox x:Name="TxtMemo"
                     Height="60"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="등록"
                    Width="80"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="BtnSave_Click"/>

            <Button Content="취소"
                    Width="80"
                    Height="35"
                    Click="BtnCancel_Click"/>

        </StackPanel>

    </Grid>
</Window>