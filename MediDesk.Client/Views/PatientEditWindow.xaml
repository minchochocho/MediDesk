<Window x:Class="MediDesk.Client.Views.PatientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="환자 수정"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        >

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="이름"/>
            <TextBox x:Name="TxtName" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="생년월일"/>
            <DatePicker x:Name="DpBirthDate" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="성별"/>
            <ComboBox x:Name="CbGender" Height="30">
                <ComboBoxItem Content="M"/>
                <ComboBoxItem Content="F"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="전화번호"/>
            <TextBox x:Name="TxtPhone" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,20">
            <TextBlock Text="주소"/>
            <TextBox x:Name="TxtAddress" Height="30"/>
        </StackPanel>

        <StackPanel
            Grid.Row="5"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            >

            <Button
                Content="수정"
                Width="80"
                Height="35"
                Margin="0,0,10,0"
                Click="BtnSave_Click"/>
            
            <Button
                Content="취소"
                Width="80"
                Height="35"
                Click="BtnCancel_Click"/>


        </StackPanel>

    </Grid>
</Window>